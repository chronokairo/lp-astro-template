          class="btn btn-lime"
        >
          Start free
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow">
            <path d="M 4 12.3 C 8 12.1, 13 12.4, 19.5 12" />
            <path d="M 13.5 6.5 C 15 8, 17 10, 19.5 12 C 17 14, 15 16, 13.5 17.5" />
          </svg>
        </a>
        <a
          href="https://github.com/pattern-ai-labs/agentcall"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          Star on GitHub
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow">
            <path d="M 4 12.3 C 8 12.1, 13 12.4, 19.5 12" />
            <path d="M 13.5 6.5 C 15 8, 17 10, 19.5 12 C 17 14, 15 16, 13.5 17.5" />
          </svg>
        </a>
        <a
          href="https://www.youtube.com/@pattern-ai-labs"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-soft"
        >
          Watch on YouTube
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow">
            <path d="M 4 12.3 C 8 12.1, 13 12.4, 19.5 12" />
            <path d="M 13.5 6.5 C 15 8, 17 10, 19.5 12 C 17 14, 15 16, 13.5 17.5" />
          </svg>
        </a>
      </div>

      <!-- Hero meta -->
      <div class="hero-meta" style="display:flex; gap:20px; align-items:center; flex-wrap:wrap; font-size:13px; color:var(--muted);">
        <span class="hero-meta-item" style="display:flex; gap:8px; align-items:center;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--ink);"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
          Real-time transcription
        </span>
        <span class="hero-meta-item" style="display:flex; gap:8px; align-items:center;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--ink);"><path d="M12 2L2 7l10 5 10-5L12 2z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>
          Voice intelligence
        </span>
        <span class="hero-meta-item" style="display:flex; gap:8px; align-items:center;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--ink);"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><path d="M3 9l18-6" /></svg>
          Audit logging
        </span>
      </div>
    </div>

    <!-- Hero visual: meeting card + live caption + terminal -->
    <div class="hero-visual" style="position:relative; margin-top:20px;">
      <!-- Meeting card -->
      <div class="meeting-card" style="background:var(--bg-dark); border-radius:var(--radius-lg); padding:22px; box-shadow:var(--shadow-lg); color:#e8e6df; position:relative; overflow:hidden; transform:rotate(-0.6deg);">
        <div class="meeting-bar" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
          <div class="meeting-pills" style="display:flex; gap:6px;">
            <span style="width:11px; height:11px; border-radius:50%; background:#3a3b34;"></span>
            <span style="width:11px; height:11px; border-radius:50%; background:#ff5f57;"></span>
            <span style="width:11px; height:11px; border-radius:50%; background:#febc2e;"></span>
            <span style="width:11px; height:11px; border-radius:50%; background:#28c840;"></span>
          </div>
          <div>
            <div class="meeting-name" style="font-family:var(--mono); font-size:11px; color:#8d8a7e; letter-spacing:0.1em; text-transform:uppercase;">agentcall.dev — june</div>
            <div class="meeting-time" style="font-family:var(--mono); font-size:11px; color:var(--lime); letter-spacing:0.08em;">00:42:15</div>
          </div>
        </div>
        <div class="meeting-grid" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px;">
          <div class="participant" style="aspect-ratio:4/3; border-radius:14px; background:linear-gradient(135deg, #21221c, #181913); position:relative; overflow:hidden; display:flex; align-items:flex-end; padding:10px; border:1px solid rgba(255,255,255,0.04);">
            <div class="avatar" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -55%); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; color:var(--bg); letter-spacing:-0.02em;">A</div>
            <div class="name-tag" style="font-family:var(--mono); font-size:10px; letter-spacing:0.08em; color:#d4d2c8; background:rgba(0,0,0,0.4); padding:4px 7px; border-radius:5px; backdrop-filter:blur(4px);">Alice</div>
          </div>
          <div class="participant bot" style="aspect-ratio:4/3; border-radius:14px; background:linear-gradient(135deg, #1f261a 0%, #161a13 100%); position:relative; overflow:hidden; display:flex; align-items:flex-end; padding:10px; border:1px solid rgba(200,255,58,0.45); box-shadow:0 0 0 3px rgba(200,255,58,0.12), inset 0 0 60px rgba(200,255,58,0.08);">
            <div class="avatar" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -55%); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; color:var(--ink-on-lime); background:var(--lime); box-shadow:0 0 30px rgba(200,255,58,0.5); letter-spacing:-0.02em;">J</div>
            <div class="name-tag" style="font-family:var(--mono); font-size:10px; letter-spacing:0.08em; color:#d4d2c8; background:rgba(0,0,0,0.4); padding:4px 7px; border-radius:5px; backdrop-filter:blur(4px);">June · bot</div>
          </div>
          <div class="participant" style="aspect-ratio:4/3; border-radius:14px; background:linear-gradient(135deg, #21221c, #181913); position:relative; overflow:hidden; display:flex; align-items:flex-end; padding:10px; border:1px solid rgba(255,255,255,0.04);">
            <div class="avatar" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -55%); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; color:var(--bg); letter-spacing:-0.02em;">B</div>
            <div class="name-tag" style="font-family:var(--mono); font-size:10px; letter-spacing:0.08em; color:#d4d2c8; background:rgba(0,0,0,0.4); padding:4px 7px; border-radius:5px; backdrop-filter:blur(4px);">Ben</div>
          </div>
        </div>
      </div>

      <!-- Live caption -->
      <div class="live-caption" style="position:absolute; left:22px; right:22px; bottom:22px; background:rgba(15,17,12,0.85); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.06); border-radius:14px; padding:14px 16px; display:flex; gap:12px; align-items:flex-start; transform:translateY(0); opacity:1;">
        <div class="badge" style="width:28px; height:28px; border-radius:8px; background:var(--lime); color:var(--ink-on-lime); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:12px; flex-shrink:0;">J</div>
        <div>
          <div class="speaker" style="font-family:var(--mono); font-size:10px; letter-spacing:0.1em; color:var(--lime); text-transform:uppercase; margin-bottom:2px;">June · bot · speaking</div>
          <div class="text" style="font-size:13px; color:#f3f0e8; line-height:1.4;">Q3 revenue came in at 2.4 million, that's 15% up year over year.</div>
        </div>
      </div>

      <!-- Terminal -->
      <div class="terminal" style="background:var(--bg-dark); border-radius:var(--radius); padding:0; overflow:hidden; box-shadow:var(--shadow-md); border:1px solid var(--line-dark); position:absolute; right:-10px; bottom:-30px; width:380px; transform:rotate(2deg); z-index:3;">
        <div class="term-head" style="display:flex; align-items:center; gap:8px; padding:10px 14px; background:#0a0b08; border-bottom:1px solid var(--line-dark);">
          <div class="dots" style="display:flex; gap:5px;">
            <span style="width:9px; height:9px; border-radius:50%; background:#ff5f57;"></span>
            <span style="width:9px; height:9px; border-radius:50%; background:#febc2e;"></span>
            <span style="width:9px; height:9px; border-radius:50%; background:#28c840;"></span>
          </div>
          <div class="title" style="font-family:var(--mono); font-size:11px; color:#6c6a60; margin-left:6px;">agentcall</div>
        </div>
        <div class="term-body" id="termBody" style="font-family:var(--mono); font-size:12.5px; line-height:1.65; color:#c8ccc1; padding:14px 16px; min-height:220px; max-height:280px; overflow:hidden;">
          <div class="term-line" style="white-space:pre-wrap; word-break:break-word;">
            <span class="prompt" style="color:var(--lime);">$</span> pip install agentcall
          </div>
          <div class="term-line cursor-blink" style="white-space:pre-wrap; word-break:break-word;">
            <span class="ok" style="color:var(--lime);">✓</span> installed agentcall-1.2.0
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const termBody = document.getElementById('termBody');
  const lines = [
    { html: '<span class="prompt" style="color:var(--lime);">$</span> pip install agentcall' },
    { html: '<span class="ok" style="color:var(--lime);">✓</span> installed agentcall-1.2.0', delay: 500 },
    { html: '<span class="prompt" style="color:var(--lime);">&gt;&gt;&gt;</span> <span class="kw" style="color:#ff9b75;">import</span> <span class="var" style="color:#c0c4b8;">agentcall</span>', delay: 350 },
    { html: '<span class="prompt" style="color:var(--lime);">&gt;&gt;&gt;</span> <span class="var" style="color:#c0c4b8;">client</span> = <span class="fn" style="color:#b3e36a;">agentcall.Client</span>(<span class="str" style="color:#f4d27c;">"ak_ac_…"</span>)', delay: 300 },
    { html: '<span class="prompt" style="color:var(--lime);">&gt;&gt;&gt;</span> <span class="var" style="color:#c0c4b8;">call</span> = <span class="fn" style="color:#b3e36a;">client.calls.create</span>(', delay: 350 },
    { html: '<span class="out" style="color:#d4d2c8;">      </span>meet_url=<span class="str" style="color:#f4d27c;">"meet.google.com/abc"</span>,', delay: 250 },
    { html: '<span class="out" style="color:#d4d2c8;">      </span>bot_name=<span class="str" style="color:#f4d27c;">"June"</span>, mode=<span class="str" style="color:#f4d27c;">"audio"</span>)', delay: 250 },
    { html: '<span class="ok" style="color:var(--lime);">✓</span> <span class="out" style="color:#d4d2c8;">June joined the meeting</span>', delay: 700 },
    { html: '<span class="speaker" style="color:#8cb5ff;">[Alice]</span> <span class="out" style="color:#d4d2c8;">"What were Q3 revenue numbers?"</span>', delay: 900 },
    { html: '<span class="prompt" style="color:var(--lime);">&gt;&gt;&gt;</span> <span class="fn" style="color:#b3e36a;">client.calls.inject</span>(', delay: 500 },
    { html: '<span class="out" style="color:#d4d2c8;">      </span>text=<span class="str" style="color:#f4d27c;">"Q3 came in at $2.4M, +15%"</span>)', delay: 250 },
    { html: '<span class="ok" style="color:var(--lime);">✓</span> <span class="out" style="color:#d4d2c8;">June is speaking…</span>', delay: 700 },
  ];
  let lIdx = 0;
  function tick() {
    if (!termBody) return;
    if (lIdx >= lines.length) {
      setTimeout(() => { termBody.innerHTML = ''; lIdx = 0; tick(); }, 3200);
      return;
    }
    const div = document.createElement('div');
    div.className = 'term-line';
    div.style.whiteSpace = 'pre-wrap';
    div.style.wordBreak = 'break-word';
    div.innerHTML = lines[lIdx].html;
    termBody.appendChild(div);
    if (termBody.children.length > 11) termBody.removeChild(termBody.firstChild);
    lIdx++;
    setTimeout(tick, lines[lIdx] ? (lines[lIdx].delay || 400) : 400);
  }
  const hero = document.getElementById('hero');
  if (hero) {
    const ho = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { setTimeout(tick, 800); ho.disconnect(); }
    }, { threshold: 0.2 });
    ho.observe(hero);
  }
</script>