      <!-- Sub -->
      <p class="hero-sub" style="font-size:clamp(17px, 1.6vw, 22px); color:var(--muted); max-width:50ch; line-height:1.45; letter-spacing:-0.012em; margin:0;">
        AgentCall lets any AI agent join Google Meet, Zoom, and Microsoft Teams — <strong style="color:var(--ink); font-weight:600;">speaking, listening, and collaborating like a real teammate.</strong>
