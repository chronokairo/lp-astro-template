      <!-- Headline -->
      <h1 class="hero-headline" style="font-size:clamp(40px, 6vw, 92px); font-weight:700; letter-spacing:-0.04em; line-height:0.96; max-width:none;">
        Turn any <br />
        AI agent into a <br />
        meeting <br />
        <span class="accent" style="position:relative; display:inline-block;">
          teammate.
          <span style="content:''; position:absolute; left:-3%; right:-3%; bottom:-2%; height:22%; background:var(--lime); z-index:-1; border-radius:8px 14px 10px 16px / 12px 8px 14px 10px; transform:skewY(-1.4deg) rotate(-0.5deg);"></span>
        </span>
