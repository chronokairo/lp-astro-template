<section id="hero" class="hero" style="padding:220px 0 70px; position:relative; overflow:hidden; min-height:min(86vh, 800px); display:flex; align-items:flex-start;">
  <div class="container" style="position:relative; z-index:2; width:100%;">
    <div class="hero-inner" style="display:grid; gap:28px; max-width:920px;">
