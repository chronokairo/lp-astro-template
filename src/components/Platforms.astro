<section id="platforms" class="section" style="padding:120px 0; position:relative;">
  <div class="container">
    <div class="section-head" style="margin-bottom:60px; max-width:760px;">
      <span class="section-label" style="font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.22em; color:var(--muted); display:inline-flex; align-items:center; gap:12px; margin-bottom:24px; background:var(--lime); border:1.5px solid var(--lime); border-radius:6px; box-shadow:3px 3px 0 var(--lime); color:var(--ink); transform:rotate(-1deg);">
        <span style="display:block; width:28px; height:1px; background:var(--ink);"></span>
        05 · Works everywhere
      </span>
      <h2 class="section-title" style="font-size:clamp(34px, 5vw, 64px); font-weight:700; line-height:1.02; letter-spacing:-0.04em; margin-bottom:18px;">
        One skill for <span class="serif" style="font-family:var(--serif); font-weight:400; letter-spacing:-0.02em; font-style:italic;">every</span> platform &amp; framework.
      </h2>
      <p class="section-sub" style="font-size:clamp(16px, 1.3vw, 18px); color:var(--muted); max-width:60ch; margin:0; line-height:1.55;">
        AgentCall works with the meeting platforms your team uses, the agent frameworks developers build with, and the languages they already know.
      </p>
    </div>

    <div class="platforms-grid" style="display:grid; grid-template-columns:1fr; gap:36px; background:rgba(255,255,255,0.12); border-radius:var(--radius-lg); padding:40px;">
      <div class="platform-col" style="transform:rotate(-0.2deg);">
        <h3 style="font-size:24px; font-weight:700; margin-bottom:16px; letter-spacing:-0.025em;">Meeting platforms</h3>
        <ul style="list-style:none; padding:0; margin:0; display:grid; gap:10px;">
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Google Meet</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Microsoft Teams</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Zoom</li>
        </ul>
      </div>
      <div class="platform-col" style="transform:rotate(0.3deg);">
        <h3 style="font-size:24px; font-weight:700; margin-bottom:16px; letter-spacing:-0.025em;">Agent frameworks</h3>
        <ul style="list-style:none; padding:0; margin:0; display:grid; gap:10px;">
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Claude Code</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">OpenAI Codex</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Cursor</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Gemini CLI</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">Windsurf</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">GitHub Copilot</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">JetBrains Junie</li>
          <li style="font-size:16px; color:var(--ink); padding:12px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-sm);">OpenClaw</li>
        </ul>
      </div>
    </div>
  </div>
</section>