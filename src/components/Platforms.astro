<section id="platforms" class="section platforms-section" style="padding:100px 0; position:relative; background:var(--ink); border-radius:var(--radius-lg); margin:0 20px; border:var(--ink-line); box-shadow:var(--ink-stamp-lg);">
  <div class="container" style="position:relative; z-index:2;">
    <div class="section-head" style="margin-bottom:60px; max-width:760px; color:var(--bg);">
      <span class="section-label" style="background:var(--lime); border-color:var(--lime); box-shadow:3px 3px 0 var(--lime); color:var(--ink);">
        <span style="display:block; width:28px; height:1px; background:var(--ink);"></span>
        05 · Works everywhere
      </span>
      <h2 class="section-title" style="font-size:clamp(34px, 5vw, 64px); font-weight:700; line-height:1.02; letter-spacing:-0.04em; margin-bottom:18px; color:var(--bg);">
        One skill for <span class="serif" style="font-family:var(--serif); font-weight:400; letter-spacing:-0.02em; font-style:italic;">every</span> platform &amp; framework.
      </h2>
      <p class="section-sub" style="font-size:clamp(16px, 1.3vw, 18px); color:rgba(243,240,232,0.65); max-width:60ch; margin:0; line-height:1.55;">
        AgentCall works with the meeting platforms your team uses, the agent frameworks developers build with, and the languages they already know.
      </p>
    </div>

    <div class="platforms-grid" style="display:grid; grid-template-columns:1fr; gap:1px; background:rgba(255,255,255,0.12); border-radius:var(--radius-lg); overflow:hidden;">
      <div class="platform-col" style="background:var(--ink); padding:32px; border:none; box-shadow:none; transform:rotate(-0.2deg);">
        <h3 style="font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:0.14em; margin-bottom:24px; color:var(--lime); font-family:var(--mono);">Meeting platforms</h3>
        <ul style="list-style:none; padding:0; margin:0; display:grid; gap:10px;">
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Google Meet</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Microsoft Teams</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:none; transition:padding-left 0.3s ease, color 0.3s ease;">Zoom</li>
        </ul>
      </div>
      <div class="platform-col" style="background:var(--ink); padding:32px; border:none; box-shadow:none; transform:rotate(0.3deg);">
        <h3 style="font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:0.14em; margin-bottom:24px; color:var(--lime); font-family:var(--mono);">Agent frameworks</h3>
        <ul style="list-style:none; padding:0; margin:0; display:grid; gap:10px;">
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Claude Code</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">OpenAI Codex</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Cursor</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Gemini CLI</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">Windsurf</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">GitHub Copilot</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,0.06); transition:padding-left 0.3s ease, color 0.3s ease;">JetBrains Junie</li>
          <li style="font-size:22px; font-weight:600; letter-spacing:-0.025em; color:var(--bg); padding-bottom:10px; border-bottom:none; transition:padding-left 0.3s ease, color 0.3s ease;">OpenClaw</li>
        </ul>
      </div>
    </div>
  </div>
</section>