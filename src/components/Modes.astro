---
const modes = [
  {
    num: '01',
    title: 'Observe',
    sub: 'Your agent listens and transcribes everything said in the meeting — without interrupting. Perfect for notes, compliance, and review.',
    icon: '👂',
    best: false,
  },
  {
    num: '02',
    title: 'Collaborate',
    sub: 'Your agent speaks at the right moments, answers questions, shares screens, and posts in chat — just like a real teammate.',
    icon: '🗣️',
    best: true,
  },
  {
    num: '03',
    title: 'Act',
    sub: 'Your agent takes action: creates tickets, updates CRM, sends follow-ups, and runs workflows — all from inside the meeting.',
    icon: '⚡',
    best: false,
  },
];
---

<section id="modes" class="section" style="padding:120px 0; position:relative;">
  <div class="container">
    <div class="section-head" style="margin-bottom:60px; max-width:760px;">
      <span class="section-label" style="font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.22em; color:var(--muted); display:inline-flex; align-items:center; gap:12px; margin-bottom:24px; background:var(--bg-card); padding:7px 13px; border:1.5px solid var(--ink); border-radius:6px; box-shadow:3px 3px 0 var(--ink); transform:rotate(-1deg);">
        <span style="display:block; width:28px; height:1px; background:var(--ink);"></span>
        02 · Modes
      </span>
      <h2 class="section-title" style="font-size:clamp(34px, 5vw, 64px); font-weight:700; line-height:1.02; letter-spacing:-0.04em; margin-bottom:18px;">
        Choose how your agent <span class="serif" style="font-family:var(--serif); font-weight:400; letter-spacing:-0.02em; font-style:italic;">participates.</span>
      </h2>
      <p class="section-sub" style="font-size:clamp(16px, 1.3vw, 18px); color:var(--muted); max-width:60ch; margin:0; line-height:1.55;">
        AgentCall works in three modes — from silent observer to active collaborator to autonomous agent that takes action.
      </p>
    </div>

    <div class="modes" style="display:grid; grid-template-columns:1fr; gap:18px;">
      {modes.map((mode, i) => (
        <div class="mode" style="background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-lg); padding:32px 28px; transition:all 0.3s ease; position:relative; overflow:hidden; transform:{i === 0 ? 'rotate(-0.4deg)' : i === 1 ? 'rotate(0.3deg)' : 'rotate(-0.2deg)'};">
          <div class="mode-icon-wrap" style="width:52px; height:52px; border-radius:14px; background:{i === 1 ? 'var(--ink)' : i === 2 ? 'var(--orange)' : 'var(--lime)'}; color:{i === 1 ? 'var(--lime)' : i === 2 ? '#fff' : 'var(--ink-on-lime)'}; display:flex; align-items:center; justify-content:center; margin-bottom:24px;">
            <span style="font-size:24px;">{mode.icon}</span>
          </div>
          {mode.best && (
            <span style="display:inline-block; font-family:var(--mono); font-size:11px; color:var(--ink); padding:6px 10px; background:var(--bg-2); border-radius:6px; letter-spacing:0.02em; margin-bottom:18px;">Best for teams</span>
          )}
          <h3 style="font-size:24px; font-weight:700; margin-bottom:12px; letter-spacing:-0.025em;">{mode.title}</h3>
          <p style="color:var(--muted); margin:0 0 18px 0;">{mode.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>