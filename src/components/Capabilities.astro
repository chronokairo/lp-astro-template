---
const voiceFeatures = [
  {
    title: 'Real-time transcription',
    sub: 'Every word is captured and transcribed live, with speaker names attached. Know exactly who said what, when.',
    icon: '🎙️',
  },
  {
    title: 'Speaker diarization',
    sub: 'The agent knows who is speaking at any moment — and can address people by name when it responds.',
    icon: '👥',
  },
  {
    title: 'Partial transcripts',
    sub: 'Live updates stream as people speak, so your agent can react mid-sentence, not after the call ends.',
    icon: '⚡',
  },
  {
    title: 'Full retrieval',
    sub: 'Complete transcript and meeting summary available immediately after the call — searchable and shareable.',
    icon: '📋',
  },
  {
    title: 'Voice intelligence',
    sub: 'Natural pause detection, barge-in prevention, and smart interruption handling — the agent never talks over anyone.',
    icon: '🧠',
  },
  {
    title: 'Webhook or WebSocket',
    sub: 'Choose how you receive meeting events — push to your own endpoints or stream over WebSocket.',
    icon: '🔌',
  },
];
---

<section id="capabilities" class="section" style="padding:120px 0; position:relative; background:var(--bg-2); border-radius:var(--radius-lg); margin:0 20px;">
  <div class="container">
    <div class="section-head" style="margin-bottom:60px; max-width:760px;">
      <span class="section-label">
        <span style="display:block; width:28px; height:1px; background:var(--ink);"></span>
        03 · Capabilities
      </span>
      <h2 class="section-title" style="font-size:clamp(34px, 5vw, 64px); font-weight:700; line-height:1.02; letter-spacing:-0.04em; margin-bottom:18px;">
        What your agent can <span class="serif" style="font-family:var(--serif); font-weight:400; letter-spacing:-0.02em; font-style:italic;">do in the meeting.</span>
      </h2>
      <p class="section-sub" style="font-size:clamp(16px, 1.3vw, 18px); color:var(--muted); max-width:60ch; margin:0; line-height:1.55;">
        Voice, screen, chat, and awareness — all the building blocks your agent needs to be a real teammate.
      </p>
    </div>

    <div class="voice-wrap" style="display:grid; gap:28px; grid-template-columns:1fr;">
      {voiceFeatures.map((feat) => (
        <div class="voice-feat" style="padding:22px 24px; border:var(--ink-line); box-shadow:var(--ink-stamp); border-radius:var(--radius); background:var(--bg-card); display:flex; gap:18px; align-items:flex-start; transition:all 0.25s ease;">
          <div class="voice-feat-icon" style="width:38px; height:38px; border-radius:10px; background:var(--bg-card); border:var(--ink-thin); box-shadow:2px 2px 0 var(--ink); display:flex; align-items:center; justify-content:center; color:var(--ink); flex-shrink:0;">
            <span style="font-size:20px;">{feat.icon}</span>
          </div>
          <div>
            <h4 style="font-size:16px; font-weight:600; margin:0 0 4px 0; letter-spacing:-0.015em;">{feat.title}</h4>
            <p style="font-size:14px; color:var(--muted); margin:0; line-height:1.5;">{feat.sub}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>