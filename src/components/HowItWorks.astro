---
const steps = [
  {
    no: '1',
    title: 'Install the skill',
    sub: 'Add AgentCall to your agent framework (Claude Code, Cursor, Codex, and more) with one command.',
    code: '$ npm install -g agentcall\n$ agentcall skill install join-meeting',
  },
  {
    no: '2',
    title: 'Start your meeting',
    sub: 'Create a Google Meet, Zoom, or Teams call and paste the meeting link into your agent.',
    code: 'await client.calls.create({\n  meetUrl: "meet.google.com/abc",\n  botName: "June",\n  mode: "audio"\n})',
  },
  {
    no: '3',
    title: 'Agent joins & collaborates',
    sub: 'June enters the call, listens in real time, speaks when needed, and shares her screen — just like a human teammate.',
    code: 'client.calls.inject({ text: "Q3 revenue was $2.4M" })',
  },
];
---

<section id="how" class="section" style="padding:120px 0; position:relative;">
  <div class="container">
    <div class="section-head" style="margin-bottom:60px; max-width:760px;">
      <span class="section-label" style="font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.22em; color:var(--muted); display:inline-flex; align-items:center; gap:12px; margin-bottom:24px; background:var(--bg-card); padding:7px 13px; border:1.5px solid var(--ink); border-radius:6px; box-shadow:3px 3px 0 var(--ink); transform:rotate(-1deg);">
        <span style="display:block; width:28px; height:1px; background:var(--ink);"></span>
        01 · How it works
      </span>
      <h2 class="section-title" style="font-size:clamp(34px, 5vw, 64px); font-weight:700; line-height:1.02; letter-spacing:-0.04em; margin-bottom:18px;">
        Your agent joins the meeting — <span class="serif" style="font-family:var(--serif); font-weight:400; letter-spacing:-0.02em; font-style:italic;">in three steps.</span>
      </h2>
      <p class="section-sub" style="font-size:clamp(16px, 1.3vw, 18px); color:var(--muted); max-width:60ch; margin:0; line-height:1.55;">
        Install the skill, start a call, and your agent is there — speaking, listening, and collaborating like a real teammate.
      </p>
    </div>

    <!-- Steps -->
    <div class="steps" style="display:grid; grid-template-columns:1fr; gap:0; border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; background:var(--bg-card);">
      {steps.map((step) => (
        <div class="step" style="padding:36px 32px; border-bottom:1px solid var(--line); position:relative;">
          <div class="step-no" style="display:inline-flex; align-items:center; gap:12px; font-family:var(--mono); font-size:12px; color:var(--muted); margin-bottom:30px; letter-spacing:0.1em;">
            <span>STEP</span> <b style="font-family:var(--sans); font-weight:700; font-size:22px; color:var(--ink);">{step.no}</b>
          </div>
          <h3 style="font-size:26px; font-weight:700; margin-bottom:12px; letter-spacing:-0.025em;">{step.title}</h3>
          <p style="color:var(--muted); margin:0 0 22px 0;">{step.sub}</p>
          <div class="step-code" style="background:var(--bg-dark); border-radius:12px; padding:16px 18px; font-family:var(--mono); font-size:12.5px; color:#d4d2c8; line-height:1.7; overflow-x:auto;">
            {step.code.split('\n').map((line) => (
              <div class="term-line">
                {line
                  .replace(/(meetUrl|botName|mode|text)/g, '<span class="var">$1</span>')
                  .replace(/(await|client)/g, '<span class="kw">$1</span>')
                  .replace(/"[^"]*"/g, '<span class="str">$&</span>')
                  .replace(/(create|inject)/g, '<span class="fn">$1</span>')}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>