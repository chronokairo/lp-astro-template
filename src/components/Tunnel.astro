        <div class="tunnel-arrow">↓</div>
        <div class="tunnel-step">
          <span class="mono" style="color:var(--muted);">[2]</span>
          <span>AgentCall Tunnel opens a secure pipe</span>
        </div>
        <div class="tunnel-arrow">↓</div>
        <div class="tunnel-step url">
          <span class="mono live">✓</span>
          <span class="mono">https://x8f2k.conn.agentcall.dev</span>
        </div>
        <div class="tunnel-arrow">↓</div>
        <div class="tunnel-step">
          <span class="mono" style="color:var(--muted);">[4]</span>
          <span>Meeting bot loads it as its video feed</span>
