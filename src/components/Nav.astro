---
interface Props {
  scrolled?: boolean;
}

const { scrolled = false } = Astro.props;
---

<nav class={`nav-wrap ${scrolled ? 'scrolled' : ''}`}>
  <div class="container">
    <div class="nav" style="display:flex; align-items:center; justify-content:space-between; gap:24px;">
      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="AgentCall">
        <svg height="44" width="auto" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
          <path d="M13 10V3L4 14h7v7l9-11h-7z" fill="var(--ink)"/>
        </svg>
      </a>

      <!-- Desktop links -->
      <div class="nav-links" style="display:inline-flex; align-items:center; gap:4px; padding:6px; background:rgba(255,255,255,0.5); border:1px solid var(--line); border-radius:999px; backdrop-filter:blur(10px);">
        <a href="#how" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">How it works</a>
        <a href="#modes" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Modes</a>
        <a href="#capabilities" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Capabilities</a>
        <a href="#privacy" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Data privacy</a>
        <a href="#platforms" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Platforms</a>
        <a href="#pricing" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Pricing</a>
        <a href="#faq" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">FAQ</a>
        <a href="/blog" style="font-size:13.5px; font-weight:500; color:var(--ink-2); padding:8px 14px; border-radius:999px; transition:all 0.2s ease;">Blog</a>
      </div>

      <!-- CTAs -->
      <div class="nav-cta" style="display:flex; align-items:center; gap:10px;">
        <a href="https://github.com/pattern-ai-labs/agentcall" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="display:inline-flex; font-size:13.5px; font-weight:500; color:var(--ink); padding:10px 16px;">
          GitHub
        </a>
        <a href="https://app.agentcall.dev/login" class="btn btn-dark" style="display:inline-flex; align-items:center; gap:8px; padding:12px 20px; font-size:14px; font-weight:600; border-radius:999px; border:1px solid var(--ink); background:var(--ink); color:var(--bg); transition:all 0.25s cubic-bezier(0.4,0,0.2,1); letter-spacing:-0.01em; white-space:nowrap;">
          Start free
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Scroll progress bar -->
<div class="scroll-bar" style="position:fixed; top:0; left:0; height:2px; background:linear-gradient(90deg, var(--lime), var(--orange)); z-index:200; width:0%; transition:width 0.05s linear;"></div>

<script>
  // Scroll for navbar blur + progress bar
  const navWrap = document.querySelector('.nav-wrap');
  const scrollBar = document.querySelector('.scroll-bar');
  if (navWrap || scrollBar) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (navWrap) {
        navWrap.classList.toggle('scrolled', y > 40);
      }
      if (scrollBar) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        scrollBar.style.width = max > 0 ? Math.min((y / max) * 100, 100) + '%' : '0%';
      }
    }, { passive: true });
  }
</script>