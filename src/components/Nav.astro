---
interface Props {
  scrolled?: boolean;
}

const { scrolled = false } = Astro.props;
---

<nav class={`nav-wrap ${scrolled ? 'scrolled' : ''}`}>
  <div class="container">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:24px;">
      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="AgentCall" style="height:44px; color:var(--ink); transition:transform 0.3s ease;">
        <svg height="44" width="auto" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
          <path d="M13 10V3L4 14h7v7l9-11h-7z" fill="var(--ink)"/>
        </svg>
      </a>

      <!-- Desktop links -->
      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#modes">Modes</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#privacy">Data privacy</a>
        <a href="#platforms">Platforms</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/blog">Blog</a>
      </div>

      <!-- CTAs -->
      <div class="nav-cta" style="display:flex; align-items:center; gap:10px;">
        <a href="https://github.com/pattern-ai-labs/agentcall" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="display:inline-flex; font-size:13.5px; font-weight:500; color:var(--ink); padding:10px 16px;">GitHub</a>
        <a href="https://app.agentcall.dev/login" class="btn btn-dark">Start free</a>
      </div>

      <!-- Mobile toggle -->
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#how">How it works</a>
  <a href="#modes">Modes</a>
  <a href="#capabilities">Capabilities</a>
  <a href="#privacy">Data privacy</a>
  <a href="#platforms">Platforms</a>
  <a href="#pricing">Pricing</a>
  <a href="#faq">FAQ</a>
  <a href="/blog">Blog</a>
  <a href="https://github.com/pattern-ai-labs/agentcall" target="_blank" rel="noopener noreferrer">GitHub</a>
  <a href="https://app.agentcall.dev/login" style="background:var(--ink); color:var(--bg); text-align:center;">Start free</a>
</div>

<!-- Scroll progress bar -->
<div class="scroll-bar"></div>

<script>
  const navWrap = document.querySelector('.nav-wrap');
  const scrollBar = document.querySelector('.scroll-bar');
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');

  // Scroll for navbar blur + progress bar
  if (navWrap || scrollBar) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (navWrap) navWrap.classList.toggle('scrolled', y > 40);
      if (scrollBar) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        scrollBar.style.width = max > 0 ? Math.min((y / max) * 100, 100) + '%' : '0%';
      }
    }, { passive: true });
  }

  // Mobile nav
  if (toggle && menu) {
    const setOpen = (open) => {
      menu.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>